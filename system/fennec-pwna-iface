#!/bin/bash
# Write into pwnagotchi's config the interface actually in monitor mode, so it
# follows the plugged Wi-Fi adapter (whatever its name: wlan1, wlan1mon...).
IFACE=$(iw dev | awk '$1=="Interface"{i=$2} $1=="type"&&$2=="monitor"{print i; exit}')
[ -n "$IFACE" ] && sed -i -E "s/^[[:space:]]*iface[[:space:]]*=.*/iface = \"$IFACE\"/" /etc/pwnagotchi/config.toml
exit 0
