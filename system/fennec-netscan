#!/usr/bin/env bash
# ARP scan of the local subnet: lists devices (IP, MAC, vendor).
# Runs as root (via sudo) so nmap can retrieve MAC addresses.
ip=$(hostname -I | tr ' ' '\n' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | grep -v '^127\.' | head -n1)
[ -z "$ip" ] && exit 0
sous=$(echo "$ip" | cut -d. -f1-3).0/24
nmap -sn -n "$sous" 2>/dev/null
