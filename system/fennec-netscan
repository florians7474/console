#!/usr/bin/env bash
# Scan ARP du sous-réseau local : liste les appareils (IP, MAC, constructeur).
# Lancé en root (via sudo) pour que nmap récupère les adresses MAC.
ip=$(hostname -I | tr ' ' '\n' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | grep -v '^127\.' | head -n1)
[ -z "$ip" ] && exit 0
sous=$(echo "$ip" | cut -d. -f1-3).0/24
nmap -sn -n "$sous" 2>/dev/null
