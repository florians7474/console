#!/bin/bash
# Détecte la 1re interface wlan capable de monitor et lance pwngrid dessus.

IFACE=""
for d in /sys/class/net/wlan*; do
    [ -e "$d" ] || continue
    i=$(basename "$d")
    phy=$(cat "$d/phy80211/name" 2>/dev/null)
    if iw phy "$phy" info 2>/dev/null | grep -q "\* monitor"; then
        IFACE="$i"
        break
    fi
done

if [ -z "$IFACE" ]; then
    echo "Aucune interface compatible monitor trouvée."
    exit 1
fi

exec /usr/local/bin/pwngrid -keys /etc/pwnagotchi -peers /root/peers \
    -address 127.0.0.1:8666 -wait -iface "$IFACE"
