#!/bin/bash
# Lance pwngrid sur l'interface réellement en mode monitor (mise en place par bettercap).

IFACE=$(iw dev | awk '$1=="Interface"{i=$2} $1=="type"&&$2=="monitor"{print i; exit}')

if [ -z "$IFACE" ]; then
    echo "Aucune interface en mode monitor trouvée."
    exit 1
fi

exec /usr/local/bin/pwngrid -keys /etc/pwnagotchi -peers /root/peers \
    -address 127.0.0.1:8666 -wait -iface "$IFACE"
