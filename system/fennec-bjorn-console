#!/usr/bin/env bash
# Alimente la console web de Bjorn : recopie en direct les logs de modules
# dans temp_log.txt, que la page web de Bjorn affiche.
LOGDIR="__HOME__/Bjorn/data/logs"
OUT="$LOGDIR/temp_log.txt"
tail -n 0 -F "$LOGDIR"/*.log 2>/dev/null | while IFS= read -r line; do
  printf '%s\n' "$line" >> "$OUT"
done
