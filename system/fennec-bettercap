#!/bin/bash
# Detect a monitor-capable Wi-Fi interface, switch it to monitor and start bettercap on it.

# 1) candidate interface: the first wlan whose chip advertises monitor mode
CAND=""
for d in /sys/class/net/wlan*; do
    [ -e "$d" ] || continue
    i=$(basename "$d")
    phy=$(cat "$d/phy80211/name" 2>/dev/null)
    if iw phy "$phy" info 2>/dev/null | grep -q "\* monitor"; then
        CAND="$i"
        break
    fi
done

if [ -z "$CAND" ]; then
    echo "No monitor-capable interface found. Plug in a compatible Wi-Fi adapter."
    exit 1
fi

echo "Candidate interface: $CAND"
/sbin/airmon-ng start "$CAND" >/dev/null 2>&1

# 2) depending on the driver, airmon-ng keeps the name (e.g. wlan1) or renames it
#    (e.g. wlan1mon). We pick the interface actually in monitor mode.
IFACE=$(iw dev | awk '$1=="Interface"{i=$2} $1=="type"&&$2=="monitor"{print i; exit}')
[ -z "$IFACE" ] && IFACE="$CAND"

echo "Active monitor interface: $IFACE"
exec /usr/bin/bettercap -no-colors \
    -caplet /etc/pwnagotchi/pwnagotchi-auto.cap \
    -iface "$IFACE"
